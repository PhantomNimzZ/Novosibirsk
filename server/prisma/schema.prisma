generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


model Train {
  id        Int       @id @default(autoincrement())
  name      String
  number    String
  bookings  Booking[] // relation back to Booking
}


model Booking {
  id            Int      @id @default(autoincrement())
  passengerName String
  email         String
  idNumber      String
  trainNumber   String
  departure     String
  destination   String
  date          DateTime
  time          String
  seat          String
  price         Float
  paymentStatus String
  status        String
  train         Train    @relation(fields: [trainId], references: [id])
  trainId       Int

  createdAt     DateTime @default(now()) // ✅ new field
}


