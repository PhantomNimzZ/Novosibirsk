// server/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Booking {
  id             Int      @id @default(autoincrement())
  passengerName  String
  email          String
  idNumber       String
  trainNumber    String
  departure      String
  destination    String
  date           String
  time           String
  seat           String
  price          Float
  paymentStatus  String
  status         String
  createdAt      DateTime @default(now())
  trainId        Int
  train          Train    @relation(fields: [trainId], references: [id], onDelete: Cascade)
}

model Train {
  id                 Int       @id @default(autoincrement())
  train              String    // Train name (e.g., "Shosholoza Meyl", "Blue Train")
  trainNumber        String    // Unique train number (e.g., "SM-001-1")
  from               String
  to                 String
  time               String
  date               String
  price              Float
  seats              Int       // Total seats available
  class              String?   // Economy, Business, Luxury
  amenities          String?   // Comma-separated list
  distance           Int?      // Distance in km
  duration           Int?      // Duration in hours
  intermediateStops  String?   // JSON string of stops
  bookings           Booking[]
}
