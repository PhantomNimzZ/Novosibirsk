// server/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Booking {
  id             Int      @id @default(autoincrement())
  passengerName  String
  email          String
  idNumber       String
  trainNumber    String   // Snapshot at booking time (denormalized intentionally)
  departure      String   // Snapshot at booking time
  destination    String   // Snapshot at booking time
  date           String
  time           String
  seat           String
  price          Float    // Snapshot at booking time — frozen at purchase price
  paymentStatus  String   // Validated: Pending | Paid | Refunded | Failed
  status         String   // Validated: Active | Cancelled | Completed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  trainId        Int
  train          Train    @relation(fields: [trainId], references: [id], onDelete: Restrict)
  // onDelete: Restrict — prevents accidental deletion of trains that have bookings
  // Admin must cancel/archive all bookings first before removing a train

  // NOTE: @@unique([trainId, seat, date]) is not used because "General Seating"
  // allows multiple passengers per seat value. Uniqueness is enforced in
  // application code via a Prisma transaction (see bookings.js POST handler).
}

model Train {
  id                 Int       @id @default(autoincrement())
  trainName          String    // Human-readable name (e.g. "Shosholoza Meyl")
  trainNumber        String    // Display label (e.g. "SM-001-1"), not globally unique
  from               String
  to                 String
  time               String
  date               String
  price              Float
  seats              Int
  class              String?
  amenities          String?
  distance           Int?
  duration           Int?
  intermediateStops  String?   // JSON string of stops array
  bookings           Booking[]
}
